#!/usr/bin/env bash
# Workspace checks: WebIDL freshness, comments, clippy, JS syntax + oxlint,
# Python stack, and optional Valgrind.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

usage() {
  echo "usage: tools/check [clippy|valgrind [crate...]]" >&2
  exit 2
}

crate_args() {
  local crates=("$@")
  local args=()
  for crate in "${crates[@]}"; do
    args+=(-p "$crate")
  done
  printf '%s\n' "${args[@]}"
}

run_tool() {
  if command -v nix >/dev/null 2>&1; then
    nix develop --command "$@"
  else
    "$@"
  fi
}

run_rust() {
  run_tool cargo fmt --all --check
  run_tool cargo clippy --workspace --all-targets -- -D warnings
  # Standalone check prevents workspace feature unification from hiding
  # `tokio::time` or other non-`sync` tokio features inside `renderer`.
  run_tool cargo check -p renderer
}

OXLINT_PIN="oxlint@1.89.0"

run_js() {
  if ! command -v node >/dev/null 2>&1; then
    echo "node is required to check the embedded JavaScript (nix develop)" >&2
    exit 1
  fi
  local checked=0 status=0 file output
  while IFS= read -r -d '' file; do
    checked=$((checked + 1))
    if ! output="$(node --check "$file" 2>&1)"; then
      printf '%s\n' "$output" >&2
      status=1
    fi
  done < <(find crates/renderer/src/js -name '*.js' -print0)
  if [[ "$checked" -eq 0 ]]; then
    echo "no embedded JavaScript found under crates/renderer/src/js" >&2
    exit 1
  fi
  echo "js: checked $checked files"
  if command -v oxlint >/dev/null 2>&1; then
    oxlint -c crates/renderer/src/js/.oxlintrc.json crates/renderer/src/js || status=1
  elif [[ -x website/node_modules/.bin/oxlint ]]; then
    website/node_modules/.bin/oxlint -c crates/renderer/src/js/.oxlintrc.json crates/renderer/src/js || status=1
  elif command -v npx >/dev/null 2>&1; then
    npx --yes "$OXLINT_PIN" -c crates/renderer/src/js/.oxlintrc.json crates/renderer/src/js || status=1
  else
    echo "oxlint or npx is required to lint the embedded JavaScript" >&2
    status=1
  fi
  return "$status"
}

run_comments() {
  local matches
  matches="$(grep -rnE '^[[:space:]]*//' src crates tools tests \
    --include='*.rs' --include='*.js' \
    --exclude-dir=generated --exclude-dir=third_party --exclude-dir=node_modules \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*// (SAFETY: [^[:space:]].*|https?://[^[:space:]]+( — .+)?)$' || true)"
  local py_matches
  py_matches="$(grep -rnE '^[[:space:]]*#' tools/wpt --include='*.py' --exclude-dir=.venv \
    | grep -vE '^[^:]+:1:#!' \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*# https?://[^[:space:]]+( — .+)?$' || true)"
  if [[ -n "$matches" || -n "$py_matches" ]]; then
    [[ -n "$matches" ]] && printf '%s\n' "$matches" >&2
    [[ -n "$py_matches" ]] && printf '%s\n' "$py_matches" >&2
    echo "comments: only '// SAFETY: ...' and '// https://... [— disagreement]' are allowed" >&2
    return 1
  fi
  echo "comments: only SAFETY and spec URL citations present"
  return 0
}

RUFF_PIN="ruff@0.15.14"
TY_PIN="ty@0.0.104"

run_py() {
  if ! command -v uvx >/dev/null 2>&1; then
    echo "uvx is required to lint tools/wpt (used for the WPT venv already)" >&2
    exit 1
  fi
  uvx "$RUFF_PIN" check tools/wpt
  uvx "$RUFF_PIN" format --check tools/wpt
  run_tool python3 tools/wpt/cli.py selftest
  if [[ ! -f third_party/wpt/wpt ]]; then
    echo "py: skipping ty, WPT checkout missing (git submodule update --init third_party/wpt)" >&2
    return 0
  fi
  uvx "$TY_PIN" check --project tools/wpt tools/wpt/cli.py tools/wpt/results.py tools/wpt/profile.py tools/wpt/tinybrowser_wpt.py
}

valgrind_test() {
  nix develop --command env \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="valgrind --error-exitcode=1 --track-origins=yes" \
    cargo test --target x86_64-unknown-linux-gnu "$@"
}

run_crate_boundaries() {
  local status=0
  if grep -qE '^\s*(renderer|dom)\s*=' crates/dial/Cargo.toml crates/net/Cargo.toml; then
    echo "boundaries: crates/dial and crates/net must never depend on renderer or dom" >&2
    status=1
  fi
  if grep -qE '^\s*(renderer|rquickjs)\s*=' crates/dom/Cargo.toml; then
    echo "boundaries: crates/dom must never depend on renderer or rquickjs (ADR 0002)" >&2
    status=1
  fi
  return "$status"
}

case "${1:-clippy}" in
  clippy)
    tools/webidl/import --check
    run_crate_boundaries
    run_comments
    run_rust
    run_js
    run_py
    ;;
  valgrind)
    shift
    if [ "$#" -eq 0 ]; then
      valgrind_test --workspace
    else
      mapfile -t args < <(crate_args "$@")
      valgrind_test "${args[@]}"
    fi
    ;;
  *)
    usage
    ;;
esac
