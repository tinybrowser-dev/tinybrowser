#!/usr/bin/env bash
# Workspace checks: clippy, embedded JS syntax, rustdoc, Python, Valgrind.
#
#   clippy    `cargo fmt --all --check`, then workspace lints,
#             then `node --check` on JavaScript
#             `include_str!`'d into the renderer, then the realm-free layer
#             check (dom/ and documents.rs never name Ctx/Value/Persistent/
#             JsNode), then the parsed-type guards (target keywords and
#             origin-to-URL outside their one owner), then
#             `cargo doc --no-deps --document-private-items`
#             (intra-doc link lints are denied workspace-wide, so a bare or
#             stale path fails here instead of shipping, private items
#             included), then the Astral Python stack on tools/wpt
#             (`ruff check`, `ruff format --check`, `ty check`, all via uvx
#             with versions pinned below). Always run this.
#   valgrind  Runs test binaries under Valgrind's memcheck (the default
#             shell includes it), including the C QuickJS build. It sees
#             heap misuse and uninitialized reads across the FFI boundary
#             but does not model Rust aliasing rules, and it is slow.
#
# With no subcommand, clippy (including embedded JS). AddressSanitizer is not wired:
# `-Zsanitizer=address` makes rustc reject the sanitizer-built rquickjs-macro
# proc-macro artifacts ("can't find crate"), and neither
# `-Ztarget-applies-to-host` nor a separate host config fixed it. Valgrind
# covers the same C-side ground until that is solved.
#
# Valgrind is not a proof: it falsifies. The written `// SAFETY:`
# invariant plus review is what the AGENTS.md exception requires.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# `tools/check valgrind` with no crate names runs the workspace test suite.
# Named crates are a narrower run.

usage() {
  echo "usage: tools/check [clippy|valgrind [crate...]]" >&2
  exit 2
}

crate_args() {
  local crates=("$@")
  local args=()
  for crate in "${crates[@]}"; do
    args+=(-p "$crate")
  done
  printf '%s\n' "${args[@]}"
}

run_tool() {
  # CI runs the gate on a plain runner with the pinned toolchain installed by
  # rustup; a contributor's shell has the flake. Both must run the same
  # commands, so only the wrapper changes.
  if command -v nix >/dev/null 2>&1; then
    nix develop --command "$@"
  else
    "$@"
  fi
}

run_rust() {
  run_tool cargo fmt --all --check
  run_tool cargo clippy --workspace --all-targets -- -D warnings
}

run_js() {
  if ! command -v node >/dev/null 2>&1; then
    echo "node is required to check the embedded JavaScript (nix develop)" >&2
    exit 1
  fi
  local checked=0 status=0 file output
  while IFS= read -r -d '' file; do
    checked=$((checked + 1))
    if ! output="$(node --check "$file" 2>&1)"; then
      printf '%s\n' "$output" >&2
      status=1
    fi
  done < <(find crates/renderer/src/js -name '*.js' -print0)
  if [[ "$checked" -eq 0 ]]; then
    echo "no embedded JavaScript found under crates/renderer/src/js" >&2
    exit 1
  fi
  echo "js: checked $checked files"
  return "$status"
}

run_layers() {
  # Below `js/` there is no `Ctx`, `Value`, `Persistent`, or `JsNode`, no
  # `rquickjs`, and no reach into `crate::{js,document,engine}`: the DOM
  # layer, the document store, and the encoding sniffer hold tree/algorithm
  # code that the bindings call, never the reverse. Full-line comments may
  # name the rule.
  local pattern='\b(Ctx|Value|Persistent|JsNode)\b|rquickjs|crate::(js|document|engine)\b'
  local matches
  matches="$(grep -rnE "$pattern" crates/renderer/src/dom crates/renderer/src/documents.rs \
    crates/renderer/src/sniff.rs --include='*.rs' \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(//|/\*|\*)' || true)"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches" >&2
    echo "layer check: dom/, documents.rs, and sniff.rs must stay realm-free" >&2
    return 1
  fi
  echo "layers: dom/, documents.rs, and sniff.rs are realm-free"
  return 0
}

run_comments() {
  local matches
  matches="$(grep -rnE '^[[:space:]]*//' src crates tools tests \
    --include='*.rs' --include='*.js' \
    --exclude-dir=generated --exclude-dir=third_party --exclude-dir=node_modules \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*// (SAFETY: [^[:space:]].*|https?://[^[:space:]]+( — .+)?)$' || true)"
  local py_matches
  py_matches="$(grep -rnE '^[[:space:]]*#' tools/wpt --include='*.py' --exclude-dir=.venv \
    | grep -vE '^[^:]+:1:#!' \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*# https?://[^[:space:]]+( — .+)?$' || true)"
  if [[ -n "$matches" || -n "$py_matches" ]]; then
    [[ -n "$matches" ]] && printf '%s\n' "$matches" >&2
    [[ -n "$py_matches" ]] && printf '%s\n' "$py_matches" >&2
    echo "comments: only '// SAFETY: ...' and '// https://... [— disagreement]' are allowed" >&2
    return 1
  fi
  echo "comments: only SAFETY and spec URL citations present"
  return 0
}

run_docs() {
  # Workspace `warnings` (deny) covers rustdoc's intra-doc link lints, and
  # `--document-private-items` documents private items too, so a broken or
  # stale path fails the gate instead of shipping.
  run_tool cargo doc --workspace --no-deps --document-private-items
}

# Guards for fixes that must not grow a second copy (#239). Each one is a
# grep, so it is cheap enough to run on every check, and it fails with the
# file:line that reintroduced the old shape.
run_guards() {
  local status=0 matches
  # Browsing-context and target keywords are parsed once, in
  # `protocol::TargetName`. A renderer or browser layer that spells them is
  # checking a string the type should have carried (#226, #234, #236).
  matches="$(grep -rniE '"[_](self|blank|parent|top)"' \
    crates/renderer/src/js crates/browser/src crates/wasm/src src \
    --include='*.rs' || true)"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches" >&2
    echo "guard: target keywords belong to protocol::TargetName" >&2
    status=1
  fi
  # A tuple origin becomes a URL in one place, `net::origin_url`. Parsing
  # `ascii_serialization()` anywhere else reintroduces the string round trip
  # (#234).
  matches="$(grep -rn 'Url::parse' crates src --include='*.rs' \
    | grep 'ascii_serialization' \
    | grep -v '^crates/net/src/lib.rs:' || true)"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches" >&2
    echo "guard: parse a tuple origin with net::origin_url" >&2
    status=1
  fi
  # A CDP request decodes into one `params::*` struct per method
  # (`crates/cdp/src/params.rs`). A handler that reads raw `params.get(...)`
  # reintroduces a silent default for a field the protocol requires (#161).
  matches="$(grep -rn 'params\.get(' crates/cdp/src --include='*.rs' || true)"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches" >&2
    echo "guard: decode CDP params into a params:: struct" >&2
    status=1
  fi
  # A URL parsed with a document's encoding goes through one owner,
  # `js::url_parts::encoding_parse_url`. A second hand-rolled percent-encode
  # loop for the query reintroduces the two loaders that disagreed (#266).
  matches="$(grep -rn 'HEX\[' crates/renderer/src --include='*.rs' \
    | grep -v '^crates/renderer/src/js/url_parts.rs:' || true)"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches" >&2
    echo "guard: parse with an encoding override in js::url_parts" >&2
    status=1
  fi
  if [[ "$status" -eq 0 ]]; then
    echo "guards: no second copy of a parsed type"
  fi
  return "$status"
}

# Astral pins for the tools/wpt Python stack (ruff = lint + format, ty =
# types). Bump together after `uvx <tool>@<version>` proves green.
RUFF_PIN="ruff@0.15.14"
TY_PIN="ty@0.0.104"

run_py() {
  if ! command -v uvx >/dev/null 2>&1; then
    echo "uvx is required to lint tools/wpt (used for the WPT venv already)" >&2
    exit 1
  fi
  uvx "$RUFF_PIN" check tools/wpt
  uvx "$RUFF_PIN" format --check tools/wpt
  run_tool python3 tools/wpt/cli.py selftest
  if [[ ! -f third_party/wpt/wpt ]]; then
    # ty resolves upstream modules through extra-paths into the checkout
    # (see tools/wpt/pyproject.toml); without it only ruff can run.
    echo "py: skipping ty, WPT checkout missing (git submodule update --init third_party/wpt)" >&2
    return 0
  fi
  uvx "$TY_PIN" check --project tools/wpt tools/wpt/cli.py tools/wpt/tinybrowser_wpt.py
}

valgrind_test() {
  nix develop --command env \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="valgrind --error-exitcode=1 --track-origins=yes" \
    cargo test --target x86_64-unknown-linux-gnu "$@"
}

case "${1:-clippy}" in
  clippy)
    tools/webidl/import --check
    run_comments
    run_rust
    run_js
    run_layers
    run_guards
    run_docs
    run_py
    ;;
  valgrind)
    shift
    if [ "$#" -eq 0 ]; then
      valgrind_test --workspace
    else
      mapfile -t args < <(crate_args "$@")
      valgrind_test "${args[@]}"
    fi
    ;;
  *)
    usage
    ;;
esac
