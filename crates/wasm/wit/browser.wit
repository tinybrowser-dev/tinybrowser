/// The browser component's host contract.
///
/// The component runs the fetch algorithm itself: redirects, cookies, CORS,
/// `Sec-Fetch-*`, and the referrer are decided before a request reaches this
/// contract, exactly as they are in the native browser. The host moves bytes
/// for one hop and reports what came back. It must not add policy of its own,
/// because every rule it would re-apply was already applied to the request it
/// receives.
package tinybrowser:browser@0.4.0;

interface types {
    /// One header field, name and value verbatim.
    ///
    /// Values are isomorphic: each `u8` of the wire value is the code point
    /// with the same number. A header byte that is not ASCII therefore survives
    /// the round trip instead of being rejected or replaced
    /// (<https://infra.spec.whatwg.org/#isomorphic-encode>).
    record header {
        name: string,
        value: string,
    }

    /// One HTTP exchange, shaped entirely by the fetch core.
    ///
    /// `id` correlates the exchange with its completion: the component
    /// allocates it, and the host must report it back unchanged.
    ///
    /// `owner` is the component's tab identity. The host steps that tab after
    /// it delivers the completion, which is why the component names it rather
    /// than the host: a page's first request starts while its constructor
    /// runs, before the host holds the tab handle.
    ///
    /// `headers` is the complete request header list for this hop, `Cookie`
    /// and `Sec-Fetch-*` included because the component added them. `method`,
    /// `url`, and `body` are likewise final: a redirect the component chose to
    /// follow arrives as a separate request, so the host never rewrites this
    /// one.
    record fetch-request {
        id: u64,
        owner: u64,
        /// Request method, in the spelling the HTTP grammar accepts.
        method: string,
        /// Absolute `http`/`https` URL, without a fragment.
        url: string,
        headers: list<header>,
        /// Request body bytes, absent for a bodyless request.
        body: option<list<u8>>,
        /// Milliseconds left before this hop's deadline, or absent when the
        /// hop has none. The host aborts the exchange at it and answers
        /// `timeout`; a host that ignores it is late rather than wrong,
        /// because the component checks the same deadline when the answer
        /// arrives.
        timeout-ms: option<u64>,
        /// Hard cap on `fetch-response.body`. A body larger than this is
        /// `limit`, not a truncated body: the component must never see a
        /// prefix it would treat as the whole response.
        max-body-bytes: u64,
    }

    /// One HTTP exchange's answer, unreduced.
    ///
    /// A 3xx status is reported as a status with its `Location` header in
    /// `headers`; the component decides whether to follow it. The host must
    /// not follow redirects itself, because the following exchanges carry
    /// different headers, a different cookie set, and possibly a different
    /// tainting.
    record fetch-response {
        status: u16,
        /// Whether the exchange ran over HTTP/2, which has no reason phrase
        /// (<https://www.rfc-editor.org/rfc/rfc9113#section-8.3.2>).
        http2: bool,
        /// Every response header, verbatim, `Set-Cookie` lines included and
        /// unjoined. The component parses and stores them itself, and decides
        /// which ones page script may read.
        headers: list<header>,
        /// The whole response body, capped by `fetch-request.max-body-bytes`.
        ///
        /// This transport has no progressive delivery: a page that asked for a
        /// streamed body receives this one buffered. A host must answer with
        /// the complete body rather than a prefix.
        body: list<u8>,
    }

    enum fetch-error {
        /// Name resolution failed.
        dns,
        /// Connection or proxy failure.
        connect,
        /// TLS handshake or certificate verification failed.
        tls,
        /// The hop's deadline expired.
        timeout,
        /// `max-body-bytes` was exceeded.
        limit,
        /// The host is at capacity for this request.
        queue-full,
        /// The component cancelled the request, or the tab went away.
        cancelled,
    }
}

/// Transport the component asks for network work.
interface host {
    use types.{fetch-request};

    /// Performs one HTTP exchange and returns whether it was accepted.
    ///
    /// The exchange is exactly the request it carries: one URL, one method,
    /// one header list, one body. A `true` answer obligates the host to call
    /// `engine.complete-fetch` exactly once for this `id`, unless the component
    /// cancels it first. The call returns before the exchange settles. A
    /// `false` answer means the host cannot serve this request at all, such as
    /// an unavailable intermediary; the component fails the dial itself, so the
    /// host must not complete it. Capacity pressure is instead `true` followed
    /// by `complete-fetch` with `queue-full`.
    ///
    /// Cookies travel in the header list, because the component owns the jar:
    /// it sends `Cookie` and reads `Set-Cookie`. A host that cannot set or read
    /// those fields — a browser `fetch`, which forbids both — needs an
    /// intermediary it controls, such as the development proxy described in
    /// the repository notes. The same intermediary is what lets a host answer
    /// a 3xx status instead of following it.
    start-fetch: func(request: fetch-request) -> bool;

    /// Stops work for an unfinished exchange.
    ///
    /// The component completes that request as `cancelled`, so the host must
    /// not call `complete-fetch` for the `id` afterwards.
    cancel-fetch: func(id: u64);
}

/// Page engine the host drives.
interface engine {
    use types.{fetch-error, fetch-response};

    /// What happened in a page.
    ///
    /// Navigation is the host's decision in this component: the host mounts
    /// documents, so the navigation variants a browser process would report
    /// are not produced here. A child frame reaching load arrives as `load`
    /// with that child's frame.
    variant event {
        /// A frame committed a navigation to this URL.
        navigated(string),
        /// Same-document history state was pushed or replaced.
        history-updated(tuple<string, string, history-handling>),
        /// The page requested session history traversal.
        history-traversal(s32),
        /// A frame reached `readyState = "complete"` and dispatched `load`.
        load,
        /// A host timer whose delay elapsed.
        timer(u64),
        /// A `fetch` or classic-script job finished with this HTTP status.
        fetch(u16),
        /// `send` or the body read failed.
        fetch-failed,
        /// A timer or `fetch` callback threw.
        script-failed,
        /// A frame finished parsing and dispatched `DOMContentLoaded`;
        /// subresources may still be loading.
        dom-content-loaded,
        /// A `goto` navigation failed before a document could be mounted.
        navigation-failed(string),
    }

    /// One painted viewport frame in tightly packed RGBA pixel order.
    record rendered-frame {
        width: u32,
        height: u32,
        rgba: list<u8>,
    }

    /// Whether a same-document history update added an entry or replaced one.
    enum history-handling {
        push,
        replace,
    }

    record frame-event {
        /// Frame the event happened in; `0` is the tab's main frame.
        frame: u64,
        event: event,
    }

    /// Pointer coordinates in viewport CSS pixels and button index (0 = primary).
    record pointer-event {
        x: f64,
        y: f64,
        button: u8,
    }

    /// Wheel scroll deltas at viewport CSS pixel coordinates.
    record wheel-event {
        x: f64,
        y: f64,
        delta-x: f64,
        delta-y: f64,
    }

    /// One user input event dispatched through the engine's trusted input pipeline.
    variant input-event {
        pointer-move(pointer-event),
        pointer-down(pointer-event),
        pointer-up(pointer-event),
        wheel(wheel-event),
        key-down(string),
        key-up(string),
        insert-text(string),
    }

    /// One page, driven by the host.
    ///
    /// The host owns the loop: it calls `step` after every state change it
    /// causes, then waits out the returned delay before stepping again.
    /// Nothing runs while the host does not step.
    resource tab {
        /// Mounts `html` as the tab's first document at `url`.
        ///
        /// Fails when `url` is not a valid absolute `http`/`https` URL, in
        /// which case no tab exists and nothing was mounted.
        ///
        /// The mount parses and may start requests before this constructor
        /// returns, so a host must not call any other method of this resource
        /// while a component export is on the stack: step only after the call
        /// that caused it returns.
        constructor(url: string, html: string) -> result<tab, string>;
        /// Replaces the tab's main document with `html` at `url`.
        mount: func(url: string, html: string) -> result<_, string>;
        /// Navigates the tab to `url` through the component's fetch core.
        ///
        /// Follows redirects and applies cookies and `Sec-Fetch-*` headers
        /// before mounting the resulting document on the next `step`.
        goto: func(url: string) -> result<_, string>;
        /// This tab's `fetch-request.owner` value.
        owner: func() -> u64;
        /// Current document URL (`location.href`).
        url: func() -> result<string, string>;
        /// Evaluates `source` in the main frame and returns its string
        /// coercion. Throws surface as the error side.
        eval: func(source: string) -> result<string, string>;
        /// Dispatches a trusted pointer, wheel, or keyboard event through the
        /// engine's input pipeline.
        dispatch-input: func(event: input-event) -> result<_, string>;
        /// Renders the main frame into RGBA pixels at `width` x `height`.
        render: func(width: u32, height: u32) -> result<rendered-frame, string>;
        /// Advances the page one turn: runs ready tasks until the script
        /// budget, then returns milliseconds until the next timer.
        ///
        /// Zero means ready work is still queued. Timers already moved into
        /// the task queue have no deadline, so `none` would stop the host.
        /// The host steps again immediately. `none` means the page is idle.
        ///
        /// The return value is measured after the work, so the two answers
        /// cannot disagree: a timer the page just armed is included, and a
        /// page that just went idle reports none.
        step: func() -> option<u64>;
        /// Drains pending events and clears them from the tab.
        events: func() -> result<list<frame-event>, string>;
        /// Text of the document's title.
        title: func() -> result<string, string>;
        /// Visible rendered text of the document body (`document.body.innerText`);
        /// empty before the body exists.
        text: func() -> result<string, string>;
    }

    /// Registers a font file (TTF, OTF, WOFF, or WOFF2) into the shared font
    /// database used by tabs created afterwards. Returns the number of
    /// registered families (0 if the bytes did not parse).
    register-font: func(data: list<u8>) -> u32;

    /// Delivers one exchange's outcome, returning whether it was expected.
    ///
    /// A `false` answer means the request was unknown: already cancelled, or
    /// its tab is gone. The host steps the tab reporting this request's
    /// `owner` after a `true` answer.
    complete-fetch: func(id: u64, outcome: result<fetch-response, fetch-error>) -> bool;
}

world browser {
    import host;
    export engine;
}
