{
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "globals": {
    "host": "readonly",
    "__tbApply": "readonly",
    "__tbArray": "readonly",
    "__tbArrayFrom": "readonly",
    "__tbAsciiLower": "readonly",
    "__tbBase64Bytes": "readonly",
    "__tbBase64Encode": "readonly",
    "__tbBlobData": "readonly",
    "__tbBrand": "readonly",
    "__tbByteString": "readonly",
    "__tbBytesCopy": "readonly",
    "__tbCancelPageRequest": "readonly",
    "__tbClampRound": "readonly",
    "__tbConstruct": "readonly",
    "__tbCssomRuleAddress": "readonly",
    "__tbCssomRuleAt": "readonly",
    "__tbDecode": "readonly",
    "__tbDecodeBytes": "readonly",
    "__tbDefineProperty": "readonly",
    "__tbDiscardPorts": "readonly",
    "__tbDrainClosedStream": "readonly",
    "__tbEncode": "readonly",
    "__tbEncoding": "readonly",
    "__tbEventConstructor": "readonly",
    "__tbEventEntry": "readonly",
    "__tbEventHandler": "readonly",
    "__tbEventTargetConstructor": "readonly",
    "__tbExtractBody": "readonly",
    "__tbFileData": "readonly",
    "__tbFileListData": "readonly",
    "__tbFirePortCloses": "readonly",
    "__tbFreeze": "readonly",
    "__tbGetOwnPropertyDescriptor": "readonly",
    "__tbGetOwnPropertyNames": "readonly",
    "__tbGetOwnPropertySymbols": "readonly",
    "__tbGetPrototypeOf": "readonly",
    "__tbHasOwnProperty": "readonly",
    "__tbHeadersAppendRaw": "readonly",
    "__tbHeadersConstructor": "readonly",
    "__tbHeadersGet": "readonly",
    "__tbHeadersList": "readonly",
    "__tbHeadersLookupRaw": "readonly",
    "__tbIDLDescriptor": "readonly",
    "__tbIDLFromCharCode": "readonly",
    "__tbIDLString": "readonly",
    "__tbIDLTypedArrayBuffer": "readonly",
    "__tbIDLTypedArrayByteLength": "readonly",
    "__tbIDLTypedArrayByteOffset": "readonly",
    "__tbIDLTypedArrayLength": "readonly",
    "__tbIDLTypedArraySet": "readonly",
    "__tbIDLTypedArrayTag": "readonly",
    "__tbIDLUSVString": "readonly",
    "__tbInstallGlobal": "readonly",
    "__tbInstallInterface": "readonly",
    "__tbIsArray": "readonly",
    "__tbIsArrayBuffer": "readonly",
    "__tbIsArrayBufferView": "readonly",
    "__tbIsDataView": "readonly",
    "__tbIsDate": "readonly",
    "__tbIsHeaderName": "readonly",
    "__tbIsHeaderValue": "readonly",
    "__tbIsTypedArray": "readonly",
    "__tbIsWindow": "readonly",
    "__tbWindowData": "readonly",
    "__tbIteratorSymbol": "readonly",
    "__tbJsonParse": "readonly",
    "__tbJsonStringify": "readonly",
    "__tbLookupObjectUrl": "readonly",
    "__tbMakeBlob": "readonly",
    "__tbMaterializePort": "readonly",
    "__tbMaterializePorts": "readonly",
    "__tbNativeEndings": "readonly",
    "__tbNumberCtor": "readonly",
    "__tbNumberIsFinite": "readonly",
    "__tbNumberIsNaN": "readonly",
    "__tbObjectCreate": "readonly",
    "__tbObjectKeys": "readonly",
    "__tbObjectPrototype": "readonly",
    "__tbOwnKeys": "readonly",
    "__tbPostMessageTransfer": "readonly",
    "__tbPrivateArray": "readonly",
    "__tbPrivateMap": "readonly",
    "__tbPrivateSet": "readonly",
    "__tbProgressData": "readonly",
    "__tbQueuePageRequest": "readonly",
    "__tbReaderData": "readonly",
    "__tbRegExpTest": "readonly",
    "__tbSetAdd": "readonly",
    "__tbSetConstructor": "readonly",
    "__tbSetHas": "readonly",
    "__tbSetPrototypeOf": "readonly",
    "__tbStreamBrand": "readonly",
    "__tbStreamData": "readonly",
    "__tbStreamDisturbed": "readonly",
    "__tbStreamFromPort": "readonly",
    "__tbStringCtor": "readonly",
    "__tbStringEndsWith": "readonly",
    "__tbStringIncludes": "readonly",
    "__tbStringSlice": "readonly",
    "__tbStringSplit": "readonly",
    "__tbStringStartsWith": "readonly",
    "__tbStringToLowerCase": "readonly",
    "__tbStringTrim": "readonly",
    "__tbSymbolToString": "readonly",
    "__tbToDOMString": "readonly",
    "__tbToLatin1": "readonly",
    "__tbUint8Array": "readonly",
    "__tbUtf8Decode": "readonly",
    "__tbUtf8Encode": "readonly"
  },
  "rules": {
    "constructor-super": "off",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-await-in-loop": "off",
    "no-control-regex": "off",
    "no-dupe-keys": "error",
    "no-eval": "off",
    "no-loss-of-precision": "error",
    "no-new": "off",
    "no-self-assign": "error",
    "no-undef": "error",
    "no-underscore-dangle": "off",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrors": "none",
        "varsIgnorePattern": "^(__tb|_)"
      }
    ],
    "no-useless-constructor": "off",
    "no-useless-escape": "error",
    "preserve-caught-error": "off",
    "typescript/no-extraneous-class": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-add-event-listener": "off"
  },
  "overrides": [
    {
      "files": ["scripts/primordials.js"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["scripts/intl.js"],
      "rules": {
        "no-extend-native": "off"
      }
    }
  ]
}
