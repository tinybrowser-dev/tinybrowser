---
import { counter, type Counters } from "@/lib/record"

interface Props {
  counters: Counters
  compact?: boolean
}

const { counters, compact = false } = Astro.props
const subtests = counter(counters, "subtests")
const total = Math.max(subtests, 1)

// Monochrome, by ink intensity: a pass gets the strongest ink, everything that
// is not a pass gets the second ink. A timeout is a failure here, so it shares
// the fail segment rather than reading as a separate status. Skips and
// unreported subtests use the surface colour, which is what the empty track is.
const parts = [
  { label: "pass", count: counter(counters, "subtest_pass"), className: "bar-pass" },
  {
    label: "fail",
    count:
      counter(counters, "subtest_fail") +
      counter(counters, "subtest_error") +
      counter(counters, "subtest_timeout") +
      counter(counters, "subtest_notrun"),
    className: "bar-fail",
  },
].filter((part) => part.count > 0)

const known = parts.reduce((sum, part) => sum + part.count, 0)
const other = subtests - known
if (other > 0) {
  parts.push({ label: "not run", count: other, className: "bar-rest" })
}
---

<div
  class:list={["bar", compact && "bar-compact"]}
  role="img"
  aria-label={parts.map((part) => `${part.count} ${part.label}`).join(", ")}
>
  {parts.map((part) => (
    <span
      class={part.className}
      style={`width:${(part.count / total) * 100}%`}
      title={`${part.label}: ${part.count.toLocaleString("en-US")}`}
    />
  ))}
</div>
