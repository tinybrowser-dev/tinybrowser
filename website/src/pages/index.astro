---
import Base from "@/layouts/Base.astro"
import { loadSnapshot } from "@/lib/data"
import { formatPercent, subtestPercent } from "@/lib/record"

export const prerender = true

const { latest } = loadSnapshot()
const score = latest ? subtestPercent(latest.totals) : null
---

<Base
  title="tinybrowser"
  description="A headless web browser for AI agents and automated tools. One ~12 MiB binary instead of a 400 MiB Chrome install."
>
  <section class="home measure">
    <h1>tinybrowser</h1>
    <p class="lede">
      A headless web browser for AI agents and automated tools. It opens web pages, runs JavaScript,
      fills forms, and takes screenshots. Everything ships in one ~12 MiB binary instead of a 400
      MiB Chrome install.
    </p>
    <p class="links">
      <a href="/demo">Try live demo</a>
      <a href="#install">Install</a>
      <a href="/wpt">Web standards score</a>
      <a href="https://github.com/tinybrowser-dev/tinybrowser" rel="noreferrer">GitHub</a>
    </p>
  </section>

  <section class="section measure">
    <h2>Why tinybrowser</h2>
    <dl class="strengths">
      <dt>A fraction of the size</dt>
      <dd>One ~12 MiB Rust binary. No Chrome download and no background updater.</dd>

      <dt>Fast startup and low memory</dt>
      <dd>
        Starts in milliseconds and uses far less memory than desktop Chromium, so you can run many
        tabs side by side.
      </dd>

      <dt>Real web standards</dt>
      <dd>
        Parses HTML, lays out CSS, runs JavaScript, and enforces cookies, redirects, and CORS per
        WHATWG
        specs.{latest && score !== null
          ? ` The latest run passed ${formatPercent(score)} of subtests across ${latest.totals.tests.toLocaleString("en-US")} Web Platform Test files.`
          : ""}
      </dd>

      <dt>Works with existing tools</dt>
      <dd>
        Supports Chrome DevTools Protocol (Playwright) and WebDriver. It also compiles to
        WebAssembly (WASI Preview 2) so you can embed it in another app or browser tab.
      </dd>
    </dl>
  </section>

  <section class="section measure" id="install">
    <h2>Install</h2>
    <p class="lede">
      Prebuilt binaries ship for macOS (Apple Silicon and Intel), Linux (x86_64), Windows (x86_64),
      and WebAssembly (<code>wasm32-wasip2</code>).
    </p>

    <div class="install-list">
      <div>
        <p class="install-label">macOS and Linux</p>
        <pre
          class="code-block"
        ><code>curl -fsSL https://raw.githubusercontent.com/tinybrowser-dev/tinybrowser/main/install.sh | sh</code></pre>
      </div>
      <div>
        <p class="install-label">Windows (PowerShell)</p>
        <pre
          class="code-block"
        ><code>irm https://raw.githubusercontent.com/tinybrowser-dev/tinybrowser/main/install.ps1 | iex</code></pre>
      </div>
      <div>
        <p class="install-label">Start using it</p>
        <pre class="code-block"><code>tinybrowser daemon
# or run a classic WebDriver server:
tinybrowser webdriver --port 4444</code></pre>
      </div>
    </div>

    <p class="links">
      <a href="https://github.com/tinybrowser-dev/tinybrowser/releases" rel="noreferrer">
        Download from GitHub Releases
      </a>
      <a href="/demo">Run tinybrowser in this tab</a>
    </p>
  </section>

  <section class="section measure">
    <h2>Under the hood</h2>
    <p class="lede">
      Built in Rust from Blitz, Stylo, html5ever, Taffy, and QuickJS, with a browser-owned HTTP/1.1
      and HTTP/2 network stack. Every conformance run publishes to the{" "}
      <a href="/wpt">WPT dashboard</a> and as <a href="/wpt/data/latest.json">raw JSON</a>.
    </p>
  </section>
</Base>
