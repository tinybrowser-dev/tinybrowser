---
import Base from "@/layouts/Base.astro"
import { formatPercent, subtestPercent, testPercent } from "@/lib/record"
import { loadWptSnapshot } from "@/lib/wpt-results"

export const prerender = true

const { latest } = loadWptSnapshot()
const wptSubtests = latest ? subtestPercent(latest.totals) : null
const wptFiles = latest ? testPercent(latest.totals) : null

const unixCmd =
  "curl -fsSL https://raw.githubusercontent.com/tinybrowser-dev/tinybrowser/main/install.sh | sh"
const winCmd =
  "irm https://raw.githubusercontent.com/tinybrowser-dev/tinybrowser/main/install.ps1 | iex"
const startCmd = `tinybrowser &\n# or bind a specific port (serves both CDP and WebDriver):\ntinybrowser --port 4444 &`
const agentPrompt = `Install tinybrowser (a ~17 MiB headless browser for AI agents) and set it up for browser automation:

1. Install the binary:
   - macOS / Linux: ${unixCmd}
   - Windows (PowerShell): ${winCmd}
   - Ensure the install directory (~/.local/bin or %LOCALAPPDATA%\\tinybrowser\\bin) is on PATH, then run \`tinybrowser --help\` to inspect all endpoints, flags, and paths.
2. Start the server (runs in the foreground, so append \`&\` to background it; serves both CDP and W3C WebDriver on one loopback port):
   - Auto-port (profile-locked): \`tinybrowser &\`
     Writes \`{ "pid", "host": "127.0.0.1", "port" }\` to \`$XDG_RUNTIME_DIR/tinybrowser/default/daemon.json\`.
   - Fixed port: \`tinybrowser --port 4444 &\`
   Done when \`GET http://127.0.0.1:<port>/status\` returns 200.
3. Connect over CDP (\`chromium.connectOverCDP("http://127.0.0.1:<port>")\`, using \`browser.contexts()[0].pages()[0]\`) or W3C WebDriver (\`POST http://127.0.0.1:<port>/session\`).`
---

<Base
  title="tinybrowser"
  description="A headless web browser for AI agents and automated tools in a single ~17 MiB Rust binary."
>
  <section class="home">
    <h1>tinybrowser</h1>
    <p class="links">
      <a href="/demo">Try tinybrowser in your browser</a>
    </p>
  </section>

  <section class="hook-section">
    <p class="hook">
      tinybrowser is an experimental headless browser for AI agents and automation, shipped as one
      17 MiB Rust binary. It parses HTML, applies CSS, runs JavaScript, keeps cookies and storage,
      and writes a PNG screenshot.
    </p>
    <p class="status">Experimental preview. Not production ready.</p>
  </section>

  <section class="section">
    <h2>What it does</h2>
    <dl class="features">
      <dt>Web Platform Tests</dt>
      <dd>
        {wptSubtests !== null && wptFiles !== null ? (
          <>
            The pinned suite passes {formatPercent(wptSubtests)} of subtests and{" "}
            {formatPercent(wptFiles)} of files. The <a href="/wpt">dashboard</a> has the full
            breakdown.
          </>
        ) : (
          <>The <a href="/wpt">dashboard</a> has the conformance record.</>
        )}
      </dd>

      <dt>Automation</dt>
      <dd>
        One loopback port speaks Chrome DevTools Protocol and W3C WebDriver, so Playwright and
        Selenium connect without a patch.
      </dd>

      <dt>Embedding</dt>
      <dd>
        The same engine compiles to a WASI Preview 2 component. The <a href="/demo">live demo</a>
        runs it in your browser.
      </dd>
    </dl>
  </section>

  <section class="section">
    <h2>What it doesn't do yet</h2>
    <ul class="limits">
      <li>No Service Workers, WebGL, WebAudio, or page-facing WebSockets.</li>
      <li>
        QuickJS interprets bytecode and has no JIT, so script-heavy pages run slower than they do in
        V8.
      </li>
      <li>
        Screenshots are one-shot PNGs. There is no GPU acceleration, no continuous paint loop, and
        no video.
      </li>
      <li>There is no OS process sandbox or out-of-process iframe isolation yet.</li>
      <li>TLS uses OpenSSL's fingerprint, not Chrome's JA3 or JA4.</li>
    </ul>
    <p class="limits-more">
      Those are the headlines. See
      <a href="https://github.com/tinybrowser-dev/tinybrowser/blob/main/docs/upstream.md#engine-and-upstream-limitations"
        >engine &amp; upstream limitations</a
      >
      and
      <a href="https://github.com/tinybrowser-dev/tinybrowser/issues">open issues</a>
      for the rest.
    </p>
  </section>

  <section class="section" id="install">
    <h2>Install</h2>

    <div class="install-list">
      <details class="prompt-details">
        <summary>
          <span class="prompt-summary-link">AI agent setup prompt</span>
          <button type="button" class="copy-btn" data-copy={agentPrompt} data-label="Copy prompt">
            Copy prompt
          </button>
        </summary>
        <pre class="code-block code-block-wrap"><code>{agentPrompt}</code></pre>
      </details>
      <div>
        <div class="install-head">
          <span class="install-label">macOS and Linux</span>
          <button type="button" class="copy-btn" data-copy={unixCmd} data-label="Copy">Copy</button>
        </div>
        <pre class="code-block"><code>{unixCmd}</code></pre>
      </div>
      <div>
        <div class="install-head">
          <span class="install-label">Windows (PowerShell)</span>
          <button type="button" class="copy-btn" data-copy={winCmd} data-label="Copy">Copy</button>
        </div>
        <pre class="code-block"><code>{winCmd}</code></pre>
      </div>
      <div>
        <div class="install-head">
          <span class="install-label">Start using it</span>
          <button type="button" class="copy-btn" data-copy={startCmd} data-label="Copy">
            Copy
          </button>
        </div>
        <pre class="code-block"><code>{startCmd}</code></pre>
      </div>
    </div>

    <p class="links">
      <a href="https://github.com/tinybrowser-dev/tinybrowser/releases" rel="noreferrer">
        GitHub Releases
      </a>
    </p>
  </section>

  <script is:inline>
    ;(() => {
      for (const button of document.querySelectorAll("button[data-copy]")) {
        let timer = 0
        button.addEventListener("click", async (event) => {
          event.stopPropagation()
          const text = button.getAttribute("data-copy")
          const label = button.getAttribute("data-label") || "Copy"
          if (!text) return
          let copied = false
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(text)
              copied = true
            }
          } catch {
            copied = false
          }
          if (!copied) {
            const area = document.createElement("textarea")
            area.value = text
            area.setAttribute("readonly", "")
            area.style.position = "fixed"
            area.style.opacity = "0"
            document.body.appendChild(area)
            area.select()
            try {
              copied = document.execCommand("copy")
            } catch {
              copied = false
            }
            area.remove()
          }
          if (copied) {
            clearTimeout(timer)
            button.textContent = "Copied"
            timer = window.setTimeout(() => {
              button.textContent = label
            }, 1500)
          }
        })
      }
    })()
  </script>
</Base>
