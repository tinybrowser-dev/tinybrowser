---
import AreaTable from "@/components/AreaTable.astro"
import HistoryChart from "@/components/HistoryChart.astro"
import Regressions from "@/components/Regressions.astro"
import Base from "@/layouts/Base.astro"
import {
  counter,
  formatCount,
  formatPercent,
  formatShortDate,
  shortSha,
  subtestPercent,
  testPercent,
} from "@/lib/record"
import { loadWptSnapshot } from "@/lib/wpt-results"

export const prerender = true

const { latest, index, regressions } = loadWptSnapshot()

const score = latest ? subtestPercent(latest.totals) : null
const files = latest ? testPercent(latest.totals) : null

// The newest index entry repeats `latest`. The delta is against the one before.
const previousScore = index.length > 1 ? subtestPercent(index[1].totals) : null
const delta = score !== null && previousScore !== null ? score - previousScore : null

const commitHref = latest?.product_revision
  ? `https://github.com/tinybrowser-dev/tinybrowser/commit/${latest.product_revision}`
  : null
const wptCommitHref = latest?.wpt_revision
  ? `https://github.com/web-platform-tests/wpt/commit/${latest.wpt_revision}`
  : null

// The denominator moves with the run: a file that fails before it reports any
// subtests adds tests but no subtests, so the delta is raw passing count.
const passNow = latest ? counter(latest.totals, "subtest_pass") : null
const passPrevious = index.length > 1 ? counter(index[1].totals, "subtest_pass") : null
const passDelta = passNow !== null && passPrevious !== null ? passNow - passPrevious : null

const raw = [
  ["latest.json", "latest run"],
  ["index.json", "run history"],
  ["regressions.json", "diff from previous run"],
  ["failures.jsonl.gz", "failing tests, gzipped JSONL"],
]
---

<Base
  title="Web Platform Tests for tinybrowser"
  description="tinybrowser's Web Platform Tests score, history, and regressions."
>
  <div class="page-head">
    <h1 class="page-title">Web Platform Tests</h1>
    {latest && <p class="run-meta">
      {formatShortDate(latest.time_end)} ·{" "}
      {commitHref ? (
        <a class="sha" href={commitHref} rel="noreferrer">{shortSha(latest.product_revision)}</a>
      ) : (
        "-"
      )}{" "}
      · WPT{" "}
      {wptCommitHref ? (
        <a class="sha" href={wptCommitHref} rel="noreferrer">{shortSha(latest.wpt_revision)}</a>
      ) : (
        <span class="sha">{shortSha(latest.wpt_revision)}</span>
      )}
    </p>}
  </div>

  {latest === null ? (
    <div class="empty">
      <p>No WPT runs published yet.</p>
    </div>
  ) : (
    <>
      <div class="stats">
        <div class="stat">
          <p class="stat-label">Subtests passing</p>
          <p class="stat-value">{formatPercent(score)}</p>
          <p class="stat-detail">
            {formatCount(counter(latest.totals, "subtest_pass"))} of{" "}
            {formatCount(counter(latest.totals, "subtests"))}
            {delta !== null && Math.abs(delta) >= 0.05 && <span class="delta">
              {delta >= 0 ? "+" : ""}
              {delta.toFixed(1)} pts
            </span>}
          </p>
        </div>
        <div class="stat">
          <p class="stat-label">Files passing</p>
          <p class="stat-value">{formatPercent(files)}</p>
          <p class="stat-detail">
            {formatCount(counter(latest.totals, "pass"))} of{" "}
            {formatCount(counter(latest.totals, "tests"))}
          </p>
        </div>
        <div class="stat">
          <p class="stat-label">Not run</p>
          <p class="stat-value">{formatCount(counter(latest.totals, "subtest_unreported"))}</p>
          <p class="stat-detail">unreported subtests</p>
        </div>
        <div class="stat">
          <p class="stat-label">Unexpected failures</p>
          <p class="stat-value">{formatCount(counter(latest.totals, "unexpected"))}</p>
          <p class="stat-detail">
            {formatCount(counter(latest.totals, "timeout"))} timeouts ·{" "}
            {formatCount(counter(latest.totals, "error"))} errors ·{" "}
            {formatCount(counter(latest.totals, "crash"))} crashes
          </p>
        </div>
      </div>

      <div class="section">
        <HistoryChart index={index} />
      </div>

      <div class="section">
        <Regressions regression={regressions} passDelta={passDelta} />
      </div>

      <div class="section">
        <AreaTable areas={latest.areas} />
      </div>

      <div class="section">
        <h2>Raw data</h2>
        <ul class="raw-list">
          {raw.map(([name, description]) => <li>
            <a href={`/wpt/data/${name}`}>/wpt/data/{name}</a>
            <span class="muted"> ({description})</span>
          </li>)}
        </ul>
      </div>
    </>
  )}
</Base>
