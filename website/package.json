{
  "name": "tinybrowser-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "bun run sync:wpt-results && bun run build:wasm",
    "build:wasm": "bun run scripts/build-wasm.ts",
    "check": "bun run contrast && bun run typecheck && bun run lint && bun run format && bun run build",
    "contrast": "bun scripts/check-contrast.ts",
    "cf:deploy": "bun run build && alchemy deploy --stage prod",
    "cf:destroy": "alchemy destroy --stage prod",
    "cf:plan": "bun run build && alchemy plan --stage prod",
    "dev": "bun run build && alchemy dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "sync:wpt-results": "bun run scripts/sync-wpt-results.ts",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "^0.31.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.87",
    "@bytecodealliance/jco": "^1.16.0",
    "@effect/platform-bun": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@types/node": "^26.6.6",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "7.1.0-beta"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.4"
  }
}
